{
  "name": "home-library",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply home-library --remote",
    "db:seed": "wrangler d1 execute home-library --remote --file=./db/seed.sql",
    "db:local": "wrangler d1 migrations apply home-library --local && wrangler d1 execute home-library --local --file=./db/seed.sql",
    "generate-types": "wrangler types --strict-vars=false"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
