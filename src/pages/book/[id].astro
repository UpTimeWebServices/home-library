---
import Layout from '@/layouts/Layout.astro';
import { db, workDetail } from '@/lib/db';
import { clothFor, coverUrl, placeText, samePlace } from '@/lib/format';
import { copyFlagsHtml } from '@/lib/copyFlags';

const id = Number(Astro.params.id);
const detail = Number.isInteger(id) ? await workDetail(id) : null;
if (!detail) return new Response('Book not found', { status: 404 });

const { work, copies, siblings } = detail;
const [secRes, serRes, tagRes, syncRes, allTagRes] = await db().batch([
  db().prepare('SELECT name FROM sections ORDER BY rule_order'),
  db().prepare('SELECT name FROM series ORDER BY name COLLATE NOCASE'),
  db().prepare(
    `SELECT category, tag, added_by FROM work_tags WHERE work_id = ? AND hidden = 0
      ORDER BY CASE category WHEN 'genre' THEN 0 WHEN 'mood' THEN 1 WHEN 'tag' THEN 2 WHEN 'ours' THEN 3 ELSE 4 END, weight DESC, tag`,
  ).bind(id),
  db().prepare('SELECT * FROM tag_sync WHERE work_id = ?').bind(id),
  db().prepare(`SELECT tag FROM work_tags WHERE hidden = 0 AND category <> 'warning' GROUP BY tag COLLATE NOCASE ORDER BY COUNT(*) DESC LIMIT 400`),
]);
type Tag = { category: string; tag: string; added_by: string | null };
const allTags = (tagRes?.results ?? []) as Tag[];
// One chip per tag name (Hardcover can list "Horror" as both a genre and a tag); warnings are kept apart.
const seen = new Set<string>();
const tags = allTags.filter((t) => t.category !== 'warning' && !seen.has(t.tag.toLowerCase()) && seen.add(t.tag.toLowerCase()));
const warnings = allTags.filter((t) => t.category === 'warning');
const sync = (syncRes?.results?.[0] ?? null) as { status: string; hc_slug: string | null; matched_title: string | null; matched_author: string | null; note: string | null } | null;
const tagSuggestions = ((allTagRes?.results ?? []) as { tag: string }[]).map((r) => r.tag);
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const KIND: Record<string, string> = { genre: 'Genre', mood: 'Mood', tag: 'Reader tag', ours: 'Our tag' };
const sectionNames = ((secRes?.results ?? []) as { name: string }[]).map((r) => r.name);
const seriesNames = ((serRes?.results ?? []) as { name: string }[]).map((r) => r.name);
const cover = coverUrl(work.cover_id, 'L', work.cover_url);
const ownPhoto = !!work.cover_url;
const cloth = clothFor(work.section);
const multi = copies.length > 1;

const flagText = (c: (typeof copies)[number]) =>
  [
    c.special === 'confirmed' ? 'Special edition' : c.special === 'suspected' ? 'Possibly special' : '',
    c.first_edition ? 'First edition' : '',
    c.signed ? 'Signed' : '',
    c.bedroom_flag ? 'Bedroom shelf?' : '',
    c.condition ?? '',
  ].filter(Boolean);
---

<Layout title={work.title}>
  <div class="wrap py-5 sm:py-8">
    <a href="/" id="back" class="text-sm text-ink-soft hover:text-green">Back to library</a>

    <div class="mt-4 grid gap-6 sm:grid-cols-[minmax(0,14rem)_1fr] sm:gap-10">
      <div class="mx-auto w-40 sm:mx-0 sm:w-full">
        <div
          id="cover"
          data-id={work.id}
          data-status={work.cover_status}
          class="cloth relative aspect-[2/3] overflow-hidden rounded-[3px] shadow-[2px_6px_18px_-8px_rgb(0_0_0/0.45)]"
          style={`--cloth:${cloth}`}
        >
          <div class="absolute inset-0 flex flex-col justify-between p-3 text-white">
            <span class="font-serif text-lg font-semibold leading-tight">{work.title}</span>
            <span class="text-xs opacity-80">{work.author}</span>
          </div>
          {cover && <img id="cover-img" src={cover} alt={`Cover of ${work.title}`} class="absolute inset-0 size-full object-cover" onerror="this.remove()" />}
          <div id="cover-busy" hidden class="absolute inset-0 grid place-items-center bg-black/45 text-sm font-medium text-white">Uploading…</div>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <label class="cursor-pointer font-medium text-green hover:underline">
            {ownPhoto ? 'Replace cover photo' : 'Use my own cover photo'}
            <input id="cover-file" type="file" accept="image/*" class="sr-only" />
          </label>
          {ownPhoto && <button type="button" id="cover-remove" class="text-ink-soft hover:text-ink hover:underline">Remove photo</button>}
          {!ownPhoto && <button type="button" id="cover-refresh" class="text-ink-soft hover:text-ink hover:underline">Find the cover again</button>}
        </div>
        <p id="cover-msg" class="mt-1 text-xs text-ink-soft" aria-live="polite">
          {work.cover_status === 'found' && !ownPhoto && 'Cover is a best match from Open Library. If it is the wrong edition, add a photo of yours.'}
        </p>
      </div>

      <div class="min-w-0">
        <h1 class="font-serif text-3xl font-semibold leading-tight tracking-tight text-balance sm:text-4xl [font-variation-settings:'opsz'_96]">
          {work.title}
        </h1>
        {work.author ? (
          <p class="mt-1 text-lg text-ink-soft">{work.author}</p>
        ) : (
          <p class="mt-1 text-ink-soft">No author yet. <button type="button" data-edit="author" class="font-medium text-green hover:underline">Add the author</button></p>
        )}
        {work.pub_year && <p class="mt-1 text-sm text-ink-soft">First published {work.pub_year}</p>}
        <p class="mt-3 flex flex-wrap items-center gap-2 text-sm">
          {work.section && (
            <a href={`/?s=${encodeURIComponent(work.section)}`} class="chip flex items-center gap-2">
              <span class="size-2.5 rounded-full" style={`background:${cloth}`} aria-hidden="true"></span>{work.section}
            </a>
          )}
          {work.series && (
            <a href={`/?q=${encodeURIComponent(work.series)}`} class="chip">
              {work.series}{work.series_pos !== null && ` #${work.series_pos}`}
            </a>
          )}
        </p>
        <button type="button" data-edit="title" class="mt-3 text-sm font-medium text-green hover:underline">Edit details</button>

        <form id="edit-form" hidden class="mt-4 space-y-3 rounded-lg border border-rule bg-card p-4">
          <label class="block text-sm font-medium">Title<input name="title" required value={work.title} class="mt-1 h-11 w-full rounded-lg border border-rule bg-paper px-3 text-base" /></label>
          <label class="block text-sm font-medium">Author
            <input name="authorSort" value={work.author_sort ?? ''} placeholder="Gaiman, Neil" class="mt-1 h-11 w-full rounded-lg border border-rule bg-paper px-3 text-base" />
            <span class="mt-1 block text-xs font-normal text-ink-soft">“Neil Gaiman” or “Gaiman, Neil” both work. Separate co-authors with a semicolon.</span></label>
          <label class="block text-sm font-medium">Section
            <select name="section" class="mt-1 h-11 w-full rounded-lg border border-rule bg-paper px-3 text-base">
              {sectionNames.map((n) => <option selected={n === work.section}>{n}</option>)}
            </select></label>
          <div class="grid grid-cols-[1fr_6rem] gap-2">
            <label class="block text-sm font-medium">Series<input name="series" list="book-series-list" value={work.series ?? ''} class="mt-1 h-11 w-full rounded-lg border border-rule bg-paper px-3 text-base" /></label>
            <label class="block text-sm font-medium">Number<input name="seriesPos" inputmode="decimal" value={work.series_pos ?? ''} class="mt-1 h-11 w-full rounded-lg border border-rule bg-paper px-3 text-base" /></label>
          </div>
          <datalist id="book-series-list">{seriesNames.map((n) => <option value={n} />)}</datalist>
          <label class="block text-sm font-medium">Notes<textarea name="notes" rows="2" class="mt-1 w-full rounded-lg border border-rule bg-paper px-3 py-2 text-base">{work.notes ?? ''}</textarea></label>
          <p class="text-xs text-ink-soft">Changing these doesn't move the book; its shelf stays the same.</p>
          <p id="edit-error" class="text-sm text-[#a23b2a]"></p>
          <div class="flex gap-3">
            <button class="rounded-lg bg-green px-4 py-2.5 font-medium text-paper">Save</button>
            <button type="button" id="edit-cancel" class="rounded-lg border border-rule px-4 py-2.5 font-medium">Cancel</button>
          </div>
        </form>

        <section class="mt-6" aria-labelledby="where">
          <h2 id="where" class="font-serif text-xl font-semibold">{multi ? `Where the ${copies.length} copies are` : 'Where it is'}</h2>
          <ul class="mt-3 space-y-3">
            {copies.map((c, i) => {
              const now = { room: c.room, case_label: c.case_label, shelf_label: c.shelf_label };
              const plan = { room: c.p_room, case_label: c.p_case_label, shelf_label: c.p_shelf_label };
              const flags = flagText(c);
              return (
                <li class="rounded-md border border-rule bg-card p-4">
                  {multi && <p class="mb-1 text-xs text-ink-soft">Copy {i + 1}</p>}
                  <p class="text-lg font-medium text-brass">{placeText(now)}</p>
                  {c.p_room && !samePlace(now, plan) && (
                    <p class="mt-1 text-sm text-ink-soft">Moves to {placeText(plan)} in the re-file</p>
                  )}
                  {c.borrower && <p class="mt-2 text-sm font-medium">Loaned to {c.borrower} since {c.loaned_on}</p>}
                  {flags.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-1.5 text-xs">
                      {flags.map((f) => <li class="rounded-full bg-green-soft px-2 py-0.5 text-green">{f}</li>)}
                    </ul>
                  )}
                  <p class="mt-2 text-xs text-ink-soft">
                    {c.verified ? `ISBN ${c.isbn}` : 'From the catalog spreadsheet, not scanned yet'}
                  </p>
                  {c.notes && <p class="mt-2 text-sm">{c.notes}</p>}
                  <button type="button" data-copy-edit={c.id} class="mt-2 text-sm font-medium text-green hover:underline">Edition details</button>
                  <div data-copy-slot={c.id} hidden class="mt-3 border-t border-rule pt-3"
                       set:html={copyFlagsHtml({ id: c.id, isbn: c.isbn, special: c.special, first_edition: c.first_edition, signed: c.signed, notes: c.notes })} />
                </li>
              );
            })}
          </ul>
        </section>

        <section class="mt-6" aria-labelledby="tags-h">
          <div class="flex items-baseline gap-3">
            <h2 id="tags-h" class="font-serif text-xl font-semibold">Genres &amp; moods</h2>
            <button type="button" id="tags-edit" class="text-sm font-medium text-green hover:underline">Edit</button>
          </div>
          {tags.length > 0 ? (
            <ul id="tag-list" class="mt-3 flex flex-wrap gap-1.5 text-sm">
              {tags.map((t) => (
                <li class="flex items-center">
                  <a href={`/?t=${encodeURIComponent(t.tag)}`} title={KIND[t.category] + (t.added_by ? `, added by ${t.added_by}` : '')}
                     class:list={['rounded-full px-2.5 py-0.5', t.category === 'ours' ? 'border border-brass text-brass' : t.category === 'mood' ? 'bg-rule/70 text-ink' : 'bg-green-soft text-green']}>{cap(t.tag)}</a>
                  <button type="button" data-untag={t.tag} hidden aria-label={`Remove ${t.tag}`} class="ml-0.5 rounded-full px-1.5 text-ink-soft hover:bg-rule hover:text-ink">×</button>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-ink-soft">
              {!sync ? 'Not loaded yet. The background sync is working through the library and will get to this book.' : 'None yet. Add your own with Edit.'}
            </p>
          )}
          <form id="tag-add" hidden class="mt-3 flex gap-2">
            <input name="tag" list="tag-suggest" placeholder="Add a tag, e.g. Dark romance" maxlength="60" class="h-10 min-w-0 flex-1 rounded-lg border border-rule bg-paper px-3 text-base" />
            <button class="rounded-lg bg-green px-4 font-medium text-paper">Add</button>
          </form>
          <datalist id="tag-suggest">{tagSuggestions.map((t) => <option value={cap(t)} />)}</datalist>

          {warnings.length > 0 && (
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer text-ink-soft">Content warnings ({warnings.length})</summary>
              <p class="mt-1">{warnings.map((w) => cap(w.tag)).join(' · ')}</p>
            </details>
          )}

          <div id="hc-match" class="mt-3 text-xs text-ink-soft" data-id={work.id}>
            {sync && (sync.status === 'matched' || sync.status === 'confirmed') && (
              <p>From Hardcover{sync.matched_title && <>: {sync.hc_slug ? <a class="underline hover:text-ink" href={`https://hardcover.app/books/${sync.hc_slug}`} target="_blank" rel="noopener">{sync.matched_title}</a> : sync.matched_title}{sync.matched_author && ` by ${sync.matched_author}`}</>}. <button type="button" data-fix class="underline hover:text-ink">Wrong book?</button></p>
            )}
            {sync?.status === 'uncertain' && (
              <p class="rounded-md border border-brass/50 bg-card p-3 text-sm text-ink">
                Is this the same book as <a class="underline" href={sync.hc_slug ? `https://hardcover.app/books/${sync.hc_slug}` : undefined} target="_blank" rel="noopener">{sync.matched_title}</a>{sync.matched_author && ` by ${sync.matched_author}`} on Hardcover?
                <span class="mt-2 flex gap-2">
                  <button type="button" data-hc="confirm" class="rounded-md bg-green px-3 py-1 font-medium text-paper">Yes</button>
                  <button type="button" data-fix class="rounded-md border border-rule px-3 py-1 font-medium">No</button>
                </span>
              </p>
            )}
            {sync && (sync.status === 'not_found' || sync.status === 'rejected') && (
              <p>{sync.status === 'rejected' ? 'Marked as not on Hardcover.' : 'Hardcover didn’t have a match.'} <button type="button" data-fix class="underline hover:text-ink">Link it by hand</button></p>
            )}
            <form id="hc-fix" hidden class="mt-2 space-y-2 rounded-md border border-rule bg-card p-3 text-sm text-ink">
              <label class="block">Find the book on <a class="underline" href={`https://hardcover.app/search?q=${encodeURIComponent(work.title + ' ' + (work.author ?? ''))}`} target="_blank" rel="noopener">Hardcover</a> and paste its link:
                <input name="url" placeholder="https://hardcover.app/books/…" class="mt-1 h-10 w-full rounded-lg border border-rule bg-paper px-3 text-base" /></label>
              <div class="flex flex-wrap gap-2">
                <button class="rounded-md bg-green px-3 py-1 font-medium text-paper">Use this book</button>
                <button type="button" data-hc="reject" class="rounded-md border border-rule px-3 py-1 font-medium">It isn’t on Hardcover</button>
              </div>
            </form>
            <p id="hc-msg" class="mt-1 text-sm text-[#a23b2a]" aria-live="polite"></p>
          </div>
        </section>

        {work.notes && (
          <section class="mt-6">
            <h2 class="font-serif text-xl font-semibold">Notes</h2>
            <p class="mt-2 max-w-prose">{work.notes}</p>
          </section>
        )}

        {siblings.length > 1 && (
          <section class="mt-8" aria-labelledby="series">
            <h2 id="series" class="font-serif text-xl font-semibold">In the library from {work.series}</h2>
            <ol class="mt-3 flex gap-3 overflow-x-auto pb-2">
              {siblings.map((s) => (
                <li class="w-20 shrink-0">
                  <a href={`/book/${s.id}`} aria-current={s.id === work.id ? 'page' : undefined} class="group block">
                    <div class="cloth relative aspect-[2/3] overflow-hidden rounded-[3px] group-aria-[current=page]:ring-2 group-aria-[current=page]:ring-brass" style={`--cloth:${clothFor(s.section)}`}>
                      <span class="absolute inset-1.5 font-serif text-[0.6rem] font-semibold leading-tight text-white line-clamp-6">{s.title}</span>
                      {(s.cover_url || s.cover_id) && <img src={coverUrl(s.cover_id, 'S', s.cover_url)} alt="" loading="lazy" class="absolute inset-0 size-full object-cover" onerror="this.remove()" />}
                    </div>
                    <span class="mt-1 block text-xs text-ink-soft">{s.series_pos !== null ? `#${s.series_pos}` : 'Unnumbered'}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="text-sm text-ink-soft">Missing books in this series will show on the Wishlist once recommendations are built.</p>
          </section>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { wireCopyFlags } from '@/lib/copyFlags';

  // Back keeps the library's search and filters when we came from it.
  const back = document.getElementById('back') as HTMLAnchorElement;
  if (document.referrer.startsWith(location.origin + '/') && !document.referrer.includes('/book/')) {
    back.addEventListener('click', (e) => { e.preventDefault(); history.back(); });
  }

  // ---- edit details ----
  const editForm = document.getElementById('edit-form') as HTMLFormElement;
  document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((b) =>
    b.addEventListener('click', () => {
      editForm.hidden = false;
      editForm.querySelector<HTMLInputElement>(`[name="${b.dataset.edit === 'author' ? 'authorSort' : 'title'}"]`)!.focus();
    }),
  );
  document.getElementById('edit-cancel')!.addEventListener('click', () => (editForm.hidden = true));
  editForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(editForm);
    const res = await fetch(`/api/works/${(document.getElementById('cover') as HTMLElement).dataset.id}`, {
      method: 'PATCH',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(fd.entries())),
    });
    if (res.ok) location.reload();
    else document.getElementById('edit-error')!.textContent = ((await res.json().catch(() => ({}))) as { error?: string }).error ?? 'Could not save.';
  });

  // ---- edition details per copy ----
  document.querySelectorAll<HTMLButtonElement>('[data-copy-edit]').forEach((b) =>
    b.addEventListener('click', () => {
      const slot = document.querySelector<HTMLElement>(`[data-copy-slot="${b.dataset.copyEdit}"]`)!;
      slot.hidden = !slot.hidden;
      b.textContent = slot.hidden ? 'Edition details' : 'Done';
      if (slot.hidden) location.reload();
      else wireCopyFlags(slot);
    }),
  );

  // ---- tags ----
  const workId = (document.getElementById('cover') as HTMLElement).dataset.id;
  const tagForm = document.getElementById('tag-add') as HTMLFormElement;
  document.getElementById('tags-edit')!.addEventListener('click', (e) => {
    const on = tagForm.hidden;
    tagForm.hidden = !on;
    document.querySelectorAll<HTMLButtonElement>('[data-untag]').forEach((b) => (b.hidden = !on));
    (e.currentTarget as HTMLButtonElement).textContent = on ? 'Done' : 'Edit';
    if (on) tagForm.querySelector('input')!.focus();
  });
  tagForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const tag = (tagForm.elements.namedItem('tag') as HTMLInputElement).value.trim();
    if (!tag) return;
    const res = await fetch(`/api/works/${workId}/tags`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ tag }) });
    if (res.ok) location.reload();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-untag]').forEach((b) =>
    b.addEventListener('click', async () => {
      const res = await fetch(`/api/works/${workId}/tags`, { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ tag: b.dataset.untag }) });
      if (res.ok) b.closest('li')!.remove();
    }),
  );

  // ---- Hardcover match: confirm, fix or reject ----
  const fixForm = document.getElementById('hc-fix') as HTMLFormElement;
  const hcMsg = document.getElementById('hc-msg')!;
  async function hcAction(body: Record<string, string>) {
    hcMsg.textContent = '';
    const res = await fetch(`/api/works/${workId}/hardcover`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    if (res.ok) location.reload();
    else hcMsg.textContent = ((await res.json().catch(() => ({}))) as { error?: string }).error ?? 'Something went wrong.';
  }
  document.querySelectorAll<HTMLButtonElement>('[data-fix]').forEach((b) =>
    b.addEventListener('click', () => { fixForm.hidden = false; fixForm.querySelector('input')!.focus(); }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-hc]').forEach((b) => b.addEventListener('click', () => hcAction({ action: b.dataset.hc! })));
  fixForm.addEventListener('submit', (e) => {
    e.preventDefault();
    void hcAction({ action: 'link', url: (fixForm.elements.namedItem('url') as HTMLInputElement).value });
  });

  const box = document.getElementById('cover') as HTMLElement;
  const id = box.dataset.id;

  function showCover(url: string) {
    let img = document.getElementById('cover-img') as HTMLImageElement | null;
    if (!img) {
      img = new Image();
      img.id = 'cover-img';
      img.alt = '';
      img.className = 'absolute inset-0 size-full object-cover';
      img.onerror = () => img?.remove();
      box.insertBefore(img, document.getElementById('cover-busy'));
    }
    img.src = url;
  }

  // Look up a cover if this row hasn't been searched yet.
  if (box.dataset.status === 'pending') {
    fetch(`/api/cover/${id}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        const coverId = (j as { coverId: number | null } | null)?.coverId;
        if (coverId) showCover(`https://covers.openlibrary.org/b/id/${coverId}-L.jpg`);
      })
      .catch(() => {});
  }

  // ---- your own cover photo ----
  const fileEl = document.getElementById('cover-file') as HTMLInputElement;
  const busy = document.getElementById('cover-busy') as HTMLElement;
  const msg = document.getElementById('cover-msg') as HTMLElement;

  /** Shrink a phone photo (often 4–12 MB) to ~1000px on the long side before uploading. */
  async function shrink(file: File): Promise<Blob> {
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, 1000 / Math.max(bmp.width, bmp.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bmp.width * scale);
    canvas.height = Math.round(bmp.height * scale);
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
    return new Promise((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error('encode'))), 'image/jpeg', 0.85));
  }

  fileEl.addEventListener('change', async () => {
    const file = fileEl.files?.[0];
    if (!file) return;
    busy.hidden = false;
    msg.textContent = '';
    try {
      const blob = await shrink(file).catch(() => file);
      const form = new FormData();
      form.append('file', blob, 'cover.jpg');
      const res = await fetch(`/api/cover/${id}`, { method: 'POST', body: form });
      const j = (await res.json().catch(() => ({}))) as { coverUrl?: string; error?: string };
      if (!res.ok || !j.coverUrl) throw new Error(j.error ?? `Upload failed (${res.status}).`);
      showCover(j.coverUrl);
      location.reload();
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Upload failed. Try again.';
    } finally {
      busy.hidden = true;
      fileEl.value = '';
    }
  });

  document.getElementById('cover-refresh')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    b.textContent = 'Looking…';
    const res = await fetch(`/api/cover/${id}`, { method: 'PUT' });
    const j = (await res.json().catch(() => ({}))) as { source?: string | null };
    if (res.ok && j.source) location.reload();
    else { b.disabled = false; b.textContent = 'Find the cover again'; msg.textContent = 'No cover found online. Add a photo of yours instead.'; }
  });

  document.getElementById('cover-remove')?.addEventListener('click', async () => {
    const res = await fetch(`/api/cover/${id}`, { method: 'DELETE' });
    if (res.ok) location.reload();
    else msg.textContent = 'Could not remove the photo. Try again.';
  });
</script>
