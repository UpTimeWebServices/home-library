---
import Layout from '@/layouts/Layout.astro';
import { workDetail } from '@/lib/db';
import { clothFor, coverUrl, placeText, samePlace } from '@/lib/format';

const id = Number(Astro.params.id);
const detail = Number.isInteger(id) ? await workDetail(id) : null;
if (!detail) return new Response('Book not found', { status: 404 });

const { work, copies, siblings } = detail;
const cover = coverUrl(work.cover_id, 'L', work.cover_url);
const ownPhoto = !!work.cover_url;
const cloth = clothFor(work.section);
const multi = copies.length > 1;

const flagText = (c: (typeof copies)[number]) =>
  [
    c.special === 'confirmed' ? 'Special edition' : c.special === 'suspected' ? 'Possibly special' : '',
    c.first_edition ? 'First edition' : '',
    c.signed ? 'Signed' : '',
    c.bedroom_flag ? 'Bedroom shelf?' : '',
    c.condition ?? '',
  ].filter(Boolean);
---

<Layout title={work.title}>
  <div class="wrap py-5 sm:py-8">
    <a href="/" id="back" class="text-sm text-ink-soft hover:text-green">Back to library</a>

    <div class="mt-4 grid gap-6 sm:grid-cols-[minmax(0,14rem)_1fr] sm:gap-10">
      <div class="mx-auto w-40 sm:mx-0 sm:w-full">
        <div
          id="cover"
          data-id={work.id}
          data-status={work.cover_status}
          class="cloth relative aspect-[2/3] overflow-hidden rounded-[3px] shadow-[2px_6px_18px_-8px_rgb(0_0_0/0.45)]"
          style={`--cloth:${cloth}`}
        >
          <div class="absolute inset-0 flex flex-col justify-between p-3 text-white">
            <span class="font-serif text-lg font-semibold leading-tight">{work.title}</span>
            <span class="text-xs opacity-80">{work.author}</span>
          </div>
          {cover && <img id="cover-img" src={cover} alt={`Cover of ${work.title}`} class="absolute inset-0 size-full object-cover" onerror="this.remove()" />}
          <div id="cover-busy" hidden class="absolute inset-0 grid place-items-center bg-black/45 text-sm font-medium text-white">Uploading…</div>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <label class="cursor-pointer font-medium text-green hover:underline">
            {ownPhoto ? 'Replace cover photo' : 'Use my own cover photo'}
            <input id="cover-file" type="file" accept="image/*" class="sr-only" />
          </label>
          {ownPhoto && <button type="button" id="cover-remove" class="text-ink-soft hover:text-ink hover:underline">Remove photo</button>}
        </div>
        <p id="cover-msg" class="mt-1 text-xs text-ink-soft" aria-live="polite">
          {work.cover_status === 'found' && !ownPhoto && 'Cover is a best match from Open Library. If it is the wrong edition, add a photo of yours.'}
        </p>
      </div>

      <div class="min-w-0">
        <h1 class="font-serif text-3xl font-semibold leading-tight tracking-tight text-balance sm:text-4xl [font-variation-settings:'opsz'_96]">
          {work.title}
        </h1>
        {work.author && <p class="mt-1 text-lg text-ink-soft">{work.author}</p>}
        <p class="mt-3 flex flex-wrap items-center gap-2 text-sm">
          {work.section && (
            <a href={`/?s=${encodeURIComponent(work.section)}`} class="chip flex items-center gap-2">
              <span class="size-2.5 rounded-full" style={`background:${cloth}`} aria-hidden="true"></span>{work.section}
            </a>
          )}
          {work.series && (
            <a href={`/?q=${encodeURIComponent(work.series)}`} class="chip">
              {work.series}{work.series_pos !== null && ` #${work.series_pos}`}
            </a>
          )}
        </p>

        <section class="mt-6" aria-labelledby="where">
          <h2 id="where" class="font-serif text-xl font-semibold">{multi ? `Where the ${copies.length} copies are` : 'Where it is'}</h2>
          <ul class="mt-3 space-y-3">
            {copies.map((c, i) => {
              const now = { room: c.room, case_label: c.case_label, shelf_label: c.shelf_label };
              const plan = { room: c.p_room, case_label: c.p_case_label, shelf_label: c.p_shelf_label };
              const flags = flagText(c);
              return (
                <li class="rounded-md border border-rule bg-card p-4">
                  {multi && <p class="mb-1 text-xs text-ink-soft">Copy {i + 1}</p>}
                  <p class="text-lg font-medium text-brass">{placeText(now)}</p>
                  {c.p_room && !samePlace(now, plan) && (
                    <p class="mt-1 text-sm text-ink-soft">Moves to {placeText(plan)} in the re-file</p>
                  )}
                  {c.borrower && <p class="mt-2 text-sm font-medium">Loaned to {c.borrower} since {c.loaned_on}</p>}
                  {flags.length > 0 && (
                    <ul class="mt-2 flex flex-wrap gap-1.5 text-xs">
                      {flags.map((f) => <li class="rounded-full bg-green-soft px-2 py-0.5 text-green">{f}</li>)}
                    </ul>
                  )}
                  <p class="mt-2 text-xs text-ink-soft">
                    {c.verified ? `ISBN ${c.isbn}` : 'From the catalog spreadsheet, not scanned yet'}
                  </p>
                  {c.notes && <p class="mt-2 text-sm">{c.notes}</p>}
                </li>
              );
            })}
          </ul>
        </section>

        {work.notes && (
          <section class="mt-6">
            <h2 class="font-serif text-xl font-semibold">Notes</h2>
            <p class="mt-2 max-w-prose">{work.notes}</p>
          </section>
        )}

        {siblings.length > 1 && (
          <section class="mt-8" aria-labelledby="series">
            <h2 id="series" class="font-serif text-xl font-semibold">In the library from {work.series}</h2>
            <ol class="mt-3 flex gap-3 overflow-x-auto pb-2">
              {siblings.map((s) => (
                <li class="w-20 shrink-0">
                  <a href={`/book/${s.id}`} aria-current={s.id === work.id ? 'page' : undefined} class="group block">
                    <div class="cloth relative aspect-[2/3] overflow-hidden rounded-[3px] group-aria-[current=page]:ring-2 group-aria-[current=page]:ring-brass" style={`--cloth:${clothFor(s.section)}`}>
                      <span class="absolute inset-1.5 font-serif text-[0.6rem] font-semibold leading-tight text-white line-clamp-6">{s.title}</span>
                      {(s.cover_url || s.cover_id) && <img src={coverUrl(s.cover_id, 'S', s.cover_url)} alt="" loading="lazy" class="absolute inset-0 size-full object-cover" onerror="this.remove()" />}
                    </div>
                    <span class="mt-1 block text-xs text-ink-soft">{s.series_pos !== null ? `#${s.series_pos}` : 'Unnumbered'}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="text-sm text-ink-soft">Missing books in this series will show on the Wishlist once recommendations are built.</p>
          </section>
        )}
      </div>
    </div>
  </div>
</Layout>

<script>
  // Back keeps the library's search and filters when we came from it.
  const back = document.getElementById('back') as HTMLAnchorElement;
  if (document.referrer.startsWith(location.origin + '/') && !document.referrer.includes('/book/')) {
    back.addEventListener('click', (e) => { e.preventDefault(); history.back(); });
  }

  const box = document.getElementById('cover') as HTMLElement;
  const id = box.dataset.id;

  function showCover(url: string) {
    let img = document.getElementById('cover-img') as HTMLImageElement | null;
    if (!img) {
      img = new Image();
      img.id = 'cover-img';
      img.alt = '';
      img.className = 'absolute inset-0 size-full object-cover';
      img.onerror = () => img?.remove();
      box.insertBefore(img, document.getElementById('cover-busy'));
    }
    img.src = url;
  }

  // Look up a cover if this row hasn't been searched yet.
  if (box.dataset.status === 'pending') {
    fetch(`/api/cover/${id}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        const coverId = (j as { coverId: number | null } | null)?.coverId;
        if (coverId) showCover(`https://covers.openlibrary.org/b/id/${coverId}-L.jpg`);
      })
      .catch(() => {});
  }

  // ---- your own cover photo ----
  const fileEl = document.getElementById('cover-file') as HTMLInputElement;
  const busy = document.getElementById('cover-busy') as HTMLElement;
  const msg = document.getElementById('cover-msg') as HTMLElement;

  /** Shrink a phone photo (often 4–12 MB) to ~1000px on the long side before uploading. */
  async function shrink(file: File): Promise<Blob> {
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, 1000 / Math.max(bmp.width, bmp.height));
    const canvas = document.createElement('canvas');
    canvas.width = Math.round(bmp.width * scale);
    canvas.height = Math.round(bmp.height * scale);
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
    return new Promise((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error('encode'))), 'image/jpeg', 0.85));
  }

  fileEl.addEventListener('change', async () => {
    const file = fileEl.files?.[0];
    if (!file) return;
    busy.hidden = false;
    msg.textContent = '';
    try {
      const blob = await shrink(file).catch(() => file);
      const form = new FormData();
      form.append('file', blob, 'cover.jpg');
      const res = await fetch(`/api/cover/${id}`, { method: 'POST', body: form });
      const j = (await res.json().catch(() => ({}))) as { coverUrl?: string; error?: string };
      if (!res.ok || !j.coverUrl) throw new Error(j.error ?? `Upload failed (${res.status}).`);
      showCover(j.coverUrl);
      location.reload();
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Upload failed. Try again.';
    } finally {
      busy.hidden = true;
      fileEl.value = '';
    }
  });

  document.getElementById('cover-remove')?.addEventListener('click', async () => {
    const res = await fetch(`/api/cover/${id}`, { method: 'DELETE' });
    if (res.ok) location.reload();
    else msg.textContent = 'Could not remove the photo. Try again.';
  });
</script>
