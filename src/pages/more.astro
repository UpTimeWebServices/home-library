---
import Layout from '@/layouts/Layout.astro';
import { db } from '@/lib/db';

const user = Astro.locals.user;
const { results: unmatched } = await db()
  .prepare(
    `SELECT s.name, s.sync_note FROM series s
      WHERE s.status = 'tracking' AND s.hardcover_id IS NULL AND s.last_checked IS NOT NULL
        AND EXISTS (SELECT 1 FROM works w JOIN sections sec ON sec.name = w.section WHERE w.series_id = s.id AND sec.recommend = 1)
      ORDER BY s.name COLLATE NOCASE`,
  )
  .all<{ name: string; sync_note: string | null }>();
const { results: unsure } = await db()
  .prepare(
    `SELECT w.id, w.title, w.author, ts.matched_title, ts.matched_author, ts.hc_slug
       FROM tag_sync ts JOIN works w ON w.id = ts.work_id
      WHERE ts.status = 'uncertain' ORDER BY w.author_sort COLLATE NOCASE, w.sort_title`,
  )
  .all<{ id: number; title: string; author: string | null; matched_title: string | null; matched_author: string | null; hc_slug: string | null }>();
---

<Layout title="More">
  <div class="wrap max-w-2xl space-y-8 py-6">
    <section>
      <h1 class="font-serif text-2xl font-semibold">Settings</h1>
      <p class="mt-1 text-ink-soft">Signed in as {user?.name} ({user?.email})</p>
    </section>

    <section aria-labelledby="hc" class="rounded-lg border border-rule bg-card p-5">
      <h2 id="hc" class="font-serif text-xl font-semibold">Hardcover series data</h2>
      <p class="mt-1 text-sm text-ink-soft">
        Hardcover supplies the full book list for each series you own, which powers the recommended wishlist and fills in the series when you scan a book.
        Children's and Graphic Novels/Manga series are skipped.
      </p>
      <dl id="hc-status" class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-ink-soft">Connection</dt><dd id="hc-conn">Checking…</dd>
        <dt class="text-ink-soft">Series to track</dt><dd id="hc-eligible">…</dd>
        <dt class="text-ink-soft">Matched on Hardcover</dt><dd id="hc-matched">…</dd>
        <dt class="text-ink-soft">Due for a refresh</dt><dd id="hc-due">…</dd>
      </dl>
      <button type="button" id="sync" disabled class="mt-4 rounded-lg bg-green px-4 py-2.5 font-medium text-paper disabled:opacity-50">Sync series now</button>
      <p class="mt-2 text-xs text-ink-soft">Each series is re-checked weekly so new releases show up. A full sync takes a few minutes; keep this page open.</p>
      <ol id="sync-log" class="mt-3 max-h-64 space-y-0.5 overflow-y-auto text-sm"></ol>
    </section>

    <section aria-labelledby="tg" class="rounded-lg border border-rule bg-card p-5">
      <h2 id="tg" class="font-serif text-xl font-semibold">Genres &amp; moods</h2>
      <p class="mt-1 text-sm text-ink-soft">
        Reader genres, moods and tags from Hardcover, so you can search “horror” or “dark romance”. They never change where a book is shelved.
        This runs in the background about 8 books a minute, so you don't need to keep this page open. Every book is re-checked every few months.
      </p>
      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-ink-soft">Checked</dt><dd id="tg-checked">…</dd>
        <dt class="text-ink-soft">Books with genres</dt><dd id="tg-tagged">…</dd>
        <dt class="text-ink-soft">Matches to check</dt><dd id="tg-unsure">…</dd>
        <dt class="text-ink-soft">Not on Hardcover</dt><dd id="tg-missing">…</dd>
      </dl>
      <p class="mt-3 text-sm"><a href="/?f=notags" class="font-medium text-green hover:underline">Books without genres yet</a> <span class="text-ink-soft">(add your own tags on each book's page)</span></p>
    </section>

    {unsure.length > 0 && (
      <section aria-labelledby="us">
        <h2 id="us" class="font-serif text-xl font-semibold">Are these the same book?</h2>
        <p class="mt-1 text-sm text-ink-soft">Hardcover found a close but not certain match. Their genres are already showing; say no to remove them. You can link the right Hardcover book from the book's page.</p>
        <ul id="unsure" class="mt-3 divide-y divide-rule rounded-lg border border-rule bg-card text-sm">
          {unsure.map((u) => (
            <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3" data-work={u.id}>
              <div class="min-w-0 flex-1">
                <a href={`/book/${u.id}`} class="font-medium hover:text-green">{u.title}</a>{u.author && <span class="text-ink-soft"> by {u.author}</span>}
                <span class="block text-ink-soft">Hardcover: {u.hc_slug ? <a class="underline" href={`https://hardcover.app/books/${u.hc_slug}`} target="_blank" rel="noopener">{u.matched_title}</a> : u.matched_title}{u.matched_author && ` by ${u.matched_author}`}</span>
              </div>
              <span class="flex gap-2">
                <button type="button" data-act="confirm" class="rounded-md bg-green px-3 py-1 font-medium text-paper">Yes</button>
                <button type="button" data-act="reject" class="rounded-md border border-rule px-3 py-1 font-medium">No</button>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {unmatched.length > 0 && (
      <section aria-labelledby="nm">
        <h2 id="nm" class="font-serif text-xl font-semibold">Series Hardcover couldn't match</h2>
        <p class="mt-1 text-sm text-ink-soft">These won't get recommendations. Usually the series has a different name on Hardcover, or it isn't listed there.</p>
        <ul class="mt-3 divide-y divide-rule rounded-lg border border-rule bg-card text-sm">
          {unmatched.map((s) => (
            <li class="flex justify-between gap-4 px-4 py-2"><a href={`/?q=${encodeURIComponent(s.name)}`} class="hover:text-green">{s.name}</a><span class="text-right text-ink-soft">{s.sync_note}</span></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

<script>
  interface Status {
    configured: boolean; user: string | null; error: string | null;
    sync: { eligible: number; matched: number; unmatched: number; due: number };
    tags: { total: number; checked: number; matched: number; uncertain: number; missing: number; due: number; tagged: number };
  }
  const $ = (id: string) => document.getElementById(id)!;
  const btn = $('sync') as HTMLButtonElement;
  const log = $('sync-log');

  function show(s: Status['sync']) {
    $('hc-eligible').textContent = String(s.eligible);
    $('hc-matched').textContent = `${s.matched}${s.unmatched ? ` (${s.unmatched} not found)` : ''}`;
    $('hc-due').textContent = String(s.due);
  }

  function showTags(t: Status['tags']) {
    $('tg-checked').textContent = `${t.checked.toLocaleString()} of ${t.total.toLocaleString()}${t.checked < t.total ? ` (about ${Math.ceil((t.total - t.checked) / 8 / 60)} hr to go)` : ''}`;
    $('tg-tagged').textContent = t.tagged.toLocaleString();
    $('tg-unsure').textContent = t.uncertain.toLocaleString();
    $('tg-missing').textContent = t.missing.toLocaleString();
  }

  async function load() {
    const s = (await (await fetch('/api/hardcover/status')).json()) as Status;
    show(s.sync);
    showTags(s.tags);
    if (!s.configured) $('hc-conn').textContent = 'Not set up. Add the token with: npx wrangler secret put HARDCOVER_TOKEN';
    else if (s.error) $('hc-conn').textContent = `Error: ${s.error}`;
    else {
      $('hc-conn').textContent = `Connected as ${s.user ?? 'your account'}`;
      btn.disabled = s.sync.due === 0;
      if (s.sync.due === 0) btn.textContent = 'All series are up to date';
    }
  }

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    btn.textContent = 'Syncing…';
    for (;;) {
      const res = await fetch('/api/series/sync', { method: 'POST' });
      const j = (await res.json().catch(() => ({ error: `HTTP ${res.status}` }))) as { results?: { series: string; ok: boolean; note: string; entries?: number }[]; status?: Status['sync']; stopped?: boolean; busy?: boolean; error?: string };
      if (j.busy) {
        // The background sync has Hardcover for a few seconds; wait our turn.
        await new Promise((r) => setTimeout(r, 15000));
        continue;
      }
      if (!res.ok || !j.results) {
        log.insertAdjacentHTML('beforeend', `<li class="text-[#a23b2a]">${j.error ?? 'Sync failed.'}</li>`);
        break;
      }
      for (const r of j.results) {
        const li = document.createElement('li');
        li.className = r.ok ? '' : 'text-ink-soft';
        li.textContent = `${r.series}: ${r.note}${r.entries ? `, ${r.entries} books` : ''}`;
        log.append(li);
      }
      log.scrollTop = log.scrollHeight;
      if (j.status) show(j.status);
      if (j.stopped) {
        log.insertAdjacentHTML('beforeend', '<li class="text-[#a23b2a]">Stopped: Hardcover didn\'t answer. Try again in a minute.</li>');
        break;
      }
      if (!j.results.length || !j.status?.due) break;
    }
    btn.textContent = 'Done';
    void load();
  });

  void load();
  setInterval(() => { if (!document.hidden) void load(); }, 60000);

  document.getElementById('unsure')?.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    const li = b?.closest<HTMLElement>('[data-work]');
    if (!b || !li) return;
    b.disabled = true;
    const res = await fetch(`/api/works/${li.dataset.work}/hardcover`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: b.dataset.act }) });
    if (res.ok) li.remove();
    else b.disabled = false;
  });
</script>
